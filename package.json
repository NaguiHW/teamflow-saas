{
  "name": "teamflow-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --filter @teamflow/web build && pnpm --filter @teamflow/api build",
    "dev": "pnpm --parallel --filter @teamflow/web --filter @teamflow/api dev",
    "dev:api": "pnpm --filter @teamflow/api dev",
    "dev:web": "pnpm --filter @teamflow/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
