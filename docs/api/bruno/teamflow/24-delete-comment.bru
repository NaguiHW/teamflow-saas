meta {
  name: Delete task comment
  type: http
  seq: 24
}

delete {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/tasks/{{taskId}}/comments/{{commentId}}
  body: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  # Delete task comment

  Authentication: bearer token; requires `owner`, `admin`, or `member` membership and the author or a moderator role.
  Expected response: `200` with `{ "deleted": true }`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `404` `COMMENT_NOT_FOUND`.
}
