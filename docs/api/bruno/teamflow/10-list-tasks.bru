meta {
  name: List organization tasks
  type: http
  seq: 10
}

get {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/tasks?page=1&pageSize=20&projectId={{projectId}}&status=in_progress&sortBy=createdAt&sortOrder=desc
  body: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  # List organization tasks

  Authentication: bearer token; requires any organization membership.
  Tenant scope: all results are restricted to `organizationId`.
  Expected response: `200` with `items` and `pagination`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `422` for invalid filters.
}
