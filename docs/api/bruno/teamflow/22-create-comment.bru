meta {
  name: Add task comment
  type: http
  seq: 22
}

post {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/tasks/{{taskId}}/comments
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "body": "The release checklist is ready for review."
  }
}

docs {
  # Add task comment

  Authentication: bearer token; requires `owner`, `admin`, or `member` membership.
  Expected response: `201` with `comment`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `404` `TASK_NOT_FOUND`; `422` for an empty or oversized body.
}
