meta {
  name: Create task
  type: http
  seq: 11
}

post {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/tasks
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "projectId": "{{projectId}}",
    "title": "Review launch checklist",
    "description": "Confirm the release checklist before publishing",
    "status": "todo",
    "dueDate": "2026-09-01T17:00:00.000Z",
    "assigneeId": "{{memberId}}"
  }
}

docs {
  # Create task

  Authentication: bearer token; requires `owner`, `admin`, or `member` membership.
  Expected response: `201` with `task`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `404` for an unknown project or assignee; `422` for invalid input.
}
