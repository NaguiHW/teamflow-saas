meta {
  name: List project tasks
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/mock-api/projects/{{projectId}}/tasks
  body: none
}

docs {
  # List project tasks

  Returns task items and pagination metadata for the selected project.

  Authentication: none in mock mode; the real endpoint will require organization membership.

  Expected response: `200` with `items` and `pagination`.
  Error case: `404` with `PROJECT_NOT_FOUND` for an unknown project.
}
