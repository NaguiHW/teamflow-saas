meta {
  name: Mock project tasks
  type: http
  seq: 2
}

get {
  url: {{apiBaseUrl}}/mock-api/projects/{{projectId}}/tasks
  body: none
}

headers {
  Accept: application/json
}

docs {
  # Mock project tasks

  Returns tasks belonging to a demo project.
  Authentication: none; this request documents the Phase 3 mock REST contract and is development-only.
  Expected response: `200` with `items` and `pagination`.
  Error case: `404` with `PROJECT_NOT_FOUND` for an unknown demo project.
}
