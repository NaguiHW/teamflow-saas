meta {
  name: List organization labels
  type: http
  seq: 15
}

get {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/labels?page=1&pageSize=20
  body: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  # List organization labels

  Authentication: bearer token; requires any organization membership.
  Expected response: `200` with `items` and `pagination`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `422` for invalid pagination.
}
