meta {
  name: Update task
  type: http
  seq: 13
}

patch {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/tasks/{{taskId}}
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "status": "done",
    "assigneeId": "{{memberId}}"
  }
}

docs {
  # Update task

  Authentication: bearer token; requires `owner`, `admin`, or `member` membership.
  Expected response: `200` with `task`.
  Error cases: `400` `EMPTY_UPDATE`; `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `404` `TASK_NOT_FOUND` or unknown project/assignee; `422` for invalid input.
}
