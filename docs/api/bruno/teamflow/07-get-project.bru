meta {
  name: Get project
  type: http
  seq: 7
}

get {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/projects/{{projectId}}
  body: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  # Get project

  Authentication: bearer token; requires any organization membership.
  Expected response: `200` with `project`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `404` `PROJECT_NOT_FOUND`.
}
