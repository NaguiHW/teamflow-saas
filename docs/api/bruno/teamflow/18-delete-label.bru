meta {
  name: Delete label
  type: http
  seq: 18
}

delete {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/labels/{{labelId}}
  body: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  # Delete label

  Authentication: bearer token; requires `owner` or `admin` membership.
  Expected response: `200` with `{ "deleted": true }`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `404` `LABEL_NOT_FOUND`.
}
