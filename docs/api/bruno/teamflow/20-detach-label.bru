meta {
  name: Detach label from task
  type: http
  seq: 20
}

delete {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/tasks/{{taskId}}/labels/{{labelId}}
  body: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  # Detach label from task

  Authentication: bearer token; requires `owner`, `admin`, or `member` membership.
  Expected response: `200` with `{ "detached": true }`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; invalid UUID path parameters return `422`.
}
