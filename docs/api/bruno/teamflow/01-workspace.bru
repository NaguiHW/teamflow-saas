meta {
  name: Get mock workspace
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/mock-api/workspace
  body: none
}

docs {
  # Mock workspace

  Returns the typed demo organization, active projects, task pagination metadata, and recent activity.

  Authentication: none in mock mode. This endpoint represents the authenticated workspace contract; real authentication is enforced by the API in Phase 4.

  Expected response: `200` with `organization`, `projects`, `tasks`, and `activity`.
  Error case: `503` if the mock service is unavailable.
}
