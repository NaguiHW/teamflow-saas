meta {
  name: Update member role
  type: http
  seq: 31
}

patch {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/members/{{memberId}}
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "admin"
  }
}

docs {
  # Update member role

  Changes a member role within an organization.
  Authentication: authenticated session cookie; requires `owner` or `admin` membership. Only the owner can transfer ownership.
  Tenant scope: both organization and member are validated within `organizationId`.
  Expected response: `200` with `userId` and `role`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `404` `MEMBER_NOT_FOUND`; `422` for invalid role.
}
