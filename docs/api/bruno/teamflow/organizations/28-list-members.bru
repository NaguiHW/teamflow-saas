meta {
  name: List organization members
  type: http
  seq: 28
}

get {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/members
  body: none
}

docs {
  # List organization members

  Returns profiles and roles for members of an organization.
  Authentication: authenticated session cookie; requires any organization membership.
  Tenant scope: results are restricted to `organizationId`.
  Expected response: `200` with member records.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`.
}
