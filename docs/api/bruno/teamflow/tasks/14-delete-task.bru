meta {
  name: Delete task
  type: http
  seq: 14
}

delete {
  url: {{apiBaseUrl}}/organizations/{{organizationId}}/tasks/{{taskId}}
  body: none
}


docs {
  # Delete task

  Authentication: authenticated session cookie; requires `owner`, `admin`, or `member` membership.
  Expected response: `200` with `{ "deleted": true }`.
  Error cases: `401` `UNAUTHENTICATED`; `403` `FORBIDDEN`; `404` `TASK_NOT_FOUND`.
}
